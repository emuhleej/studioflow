# Public Supabase URL and anon key. Never commit real values in another .env file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local development defaults to the safe fictional demo workspace.
VITE_DEMO_MODE=true

# Production must use false so unauthenticated visitors only see the sign-in screen.
# VITE_DEMO_MODE=false
